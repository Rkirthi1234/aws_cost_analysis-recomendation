# Cost Analyzer Agent - Deployment Configuration
# This file is used during agent deployment to AWS Bedrock AgentCore
#
# Quick setup:
#   1. Set your AWS region
#   2. Configure your accounts (payer + member)
#   3. Deploy with ./deploy.sh

# =============================================================================
# AWS Region
# =============================================================================
aws:
  region: us-east-1  # Your AWS region

# =============================================================================
# Account Configuration (REQUIRED — update with your account details)
# =============================================================================
#
# - Exactly one payer account is required (role_arn, or explicit same-account mode)
# - For a local CLI profile in the same account, omit role_arn/external_id and set
#   use_current_credentials: true. Identity is checked against the real account_id.
# - Member accounts may omit role_arn when the agent runs in the same account
# - Athena config can appear on any account type (payer or member)
# - The table field is optional — when omitted, the agent auto-discovers tables
#
# Default scenario: CUR data in payer account, VPC Flow Logs in member accounts.
# All accounts require role_arn for cross-account access via STS AssumeRole.

accounts:
  # Payer account — billing APIs and CUR Athena data
  - account_id: "<PAYER_ACCOUNT_ID>"
    role_arn: "arn:aws:iam::<PAYER_ACCOUNT_ID>:role/CostAnalyzerAgentPayerRole"
    account_type: payer
    athena:
      cur:
        database: <YOUR_CUR_DATABASE>
        # table: <YOUR_CUR_TABLE>  # Optional — omit to auto-discover

  # Member account with VPC Flow Log data
  - account_id: "<MEMBER_ACCOUNT_ID>"
    role_arn: "arn:aws:iam::<MEMBER_ACCOUNT_ID>:role/CostAnalyzerAgentMemberRole"
    account_type: member
    athena:
      vpc_flowlogs:
        database: <YOUR_VPC_DATABASE>
        # table: <YOUR_VPC_TABLE>  # Optional — omit to auto-discover

# =============================================================================
# AgentCore Deployment Configuration
# =============================================================================
agentcore:
  execution_role_arn: ""  # Optional: IAM role ARN (leave empty for auto-creation)

# =============================================================================
# Agent Model Configuration
# =============================================================================
agent:
  model:
    provider: bedrock
    model_id: global.anthropic.claude-sonnet-4-5-20250929-v1:0
    temperature: 0.1
    max_tokens: 8192
    cache_tools: true  # Enable tool caching (reduces cost by ~90%)
    cache_ttl: "5m"    # Cache TTL: "5m" (interactive) or "1h" (batch)

# =============================================================================
# MCP (Model Context Protocol) Configuration
# =============================================================================
mcp:
  enabled: true
  servers:
    aws_knowledge:
      type: http
      url: https://knowledge-mcp.global.api.aws
      enabled: true

# =============================================================================
# Tools Configuration
# =============================================================================
tools:
  enabled:
    - date
    - athena
    - analysis
    - billing
    - mcp

# =============================================================================
# Alternative-Service Evidence Tools (optional, OFF by default)
# =============================================================================
# When true, three read-only evidence tools are registered with the agent:
#   identify_high_cost_services, collect_usage_evidence, collect_resource_inventory
# They gather evidence only (no recommendations, no savings estimates) and only
# inspect accounts listed under `accounts` above. Every inspected account's role
# needs the read-only permissions listed in docs/iam-permissions.md (section 5).
alternatives:
  enabled: false

# Complete recommendation tools also use alternatives.enabled. The original three
# tools remain evidence-only. See docs/recommendations.md for scoped workload input.
alternative_decisions:
  min_coverage_pct: 80
  ec2_to_fargate:
    headroom_pct: 20
    sizing_statistic: max
  lambda_to_fargate:
    min_monthly_invocations: null
    min_average_concurrency: null
    min_active_duty_cycle_pct: null
  attestation:
    max_age_days: 30
  pricing:
    hours_per_month: 730
    currency: USD
    min_monthly_savings_usd: null
    min_savings_pct: null
  cache:
    ttl_seconds: 86400

# =============================================================================
# Cost Threshold Configuration (optional; disabled by default)
# =============================================================================
# Flags services whose cost over the period reaches a threshold. Read-only: it only
# reads Cost Explorer; nothing in AWS is changed.
#   * Compared figure: total AmortizedCost over the period (start inclusive, end
#     exclusive). Default period is month-to-date (1st of the UTC month up to, not
#     including, today). Cost Explorer data can lag by up to 24 hours.
#   * A cost equal to the threshold counts as crossed. Thresholds must be > 0.
#   * Only USD is supported (no currency conversion).
#   * Service keys come from agent/service_alternatives.yaml (ec2, s3, rds, ...).
#     'ec2' sums 'Amazon Elastic Compute Cloud - Compute' and 'EC2 - Other'
#     (EBS, NAT and data-transfer can be in 'EC2 - Other'); both are reported separately.
#   * Notification de-duplication is in memory by default. Optionally keep it in one
#     LOCAL file with dedupe.state_file (never AWS storage).
#   * The amounts below are placeholders: set thresholds that suit your account.
cost_thresholds:
  enabled: false
  currency: USD
  services:
    ec2: 0.01
    s3: 0.01
  # dedupe:
  #   state_file: ./.cost_threshold_alerts.json

# =============================================================================
# Cost Threshold Alert Tool (optional, OFF by default)
# =============================================================================
# When true, one read-only tool, detect_cost_threshold_alerts, is registered with the
# agent and the threshold section is added to the system prompt. The tool reads the
# cost_thresholds section above (it reports 'disabled' while cost_thresholds.enabled
# is false). It reports threshold status only: it sends NO notification and is NOT an
# alternative-service recommendation. Independent of alternatives.enabled.
threshold_detection:
  enabled: false

# =============================================================================
# Alternative: Centralized Logging Account
# =============================================================================
# Use this instead of the accounts section above if the agent runs in the same
# account as CUR and VPC Flow Log data. No STS AssumeRole needed for Athena
# queries since the data is local. The payer account is only needed for billing
# API calls.
#
# accounts:
#   # Payer account — billing APIs only
#   - account_id: "<PAYER_ACCOUNT_ID>"
#     role_arn: "arn:aws:iam::<PAYER_ACCOUNT_ID>:role/CostAnalyzerAgentPayerRole"
#     account_type: payer
#
#   # Local account — agent runs here, no role_arn needed
#   - account_id: "<LOCAL_ACCOUNT_ID>"
#     account_type: member
#     athena:
#       cur:
#         database: <YOUR_CUR_DATABASE>
#         # table: <YOUR_CUR_TABLE>  # Optional — omit to auto-discover
#       vpc_flowlogs:
#         database: <YOUR_VPC_DATABASE>
#         # table: <YOUR_VPC_TABLE>  # Optional — omit to auto-discover
